<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" version="4">
<Item class="Script" referent="P0"><Properties><string name="Name">DegenTemplates</string><ProtectedString name="Source"><![CDATA[-- Degen Templates — Roblox Studio plugin (built by make_rbxmx.py; lives in %LOCALAPPDATA%\Roblox\Plugins).
-- Toolbar "Degen Templates" → opens a list of every template; click one to insert it.
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")
local templates = script:WaitForChild("Templates")

local toolbar = plugin:CreateToolbar("Degen Templates")
local button = toolbar:CreateButton("Templates", "Insert a Degen template", "rbxasset://textures/StudioToolbox/AssetPreview/MoreDetails.png")
button.ClickableWhenViewportHidden = true

local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, false, 280, 420, 220, 260)
local widget = plugin:CreateDockWidgetPluginGui("DegenTemplates", info)
widget.Title = "Degen Templates"

local frame = Instance.new("ScrollingFrame")
frame.Size = UDim2.fromScale(1, 1); frame.CanvasSize = UDim2.new(); frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
frame.BackgroundColor3 = Color3.fromRGB(11, 11, 13); frame.BorderSizePixel = 0; frame.ScrollBarThickness = 6
frame.Parent = widget
local list = Instance.new("UIListLayout"); list.Padding = UDim.new(0, 6); list.Parent = frame
local pad = Instance.new("UIPadding"); for _, k in ipairs({"PaddingTop","PaddingBottom","PaddingLeft","PaddingRight"}) do pad[k] = UDim.new(0, 8) end; pad.Parent = frame

local function where(t)
	local sel = Selection:Get()[1]
	if sel then return sel end
	if t:IsA("LocalScript") then return game:GetService("StarterPlayer"):FindFirstChildOfClass("StarterPlayerScripts") end
	if t:IsA("Script") then return game:GetService("ServerScriptService") end
	return game:GetService("ReplicatedStorage")
end

for _, t in ipairs(templates:GetChildren()) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 40); b.BackgroundColor3 = Color3.fromRGB(20, 20, 26); b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold; b.TextSize = 14; b.TextXAlignment = Enum.TextXAlignment.Left
	b.Text = "  " .. t.Name .. "  ·  " .. t.ClassName; b.AutoButtonColor = true
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = b
	local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(225, 29, 46); s.Thickness = 1; s.Parent = b
	b.Parent = frame
	b.Activated:Connect(function()
		local rec = ChangeHistoryService:TryBeginRecording("Insert " .. t.Name)
		local copy = t:Clone(); copy.Parent = where(t)
		Selection:Set({ copy })
		if rec then ChangeHistoryService:FinishRecording(rec, Enum.FinishRecordingOperation.Commit) end
		print("[Degen Templates] inserted " .. t.Name .. " into " .. copy.Parent:GetFullName())
	end)
end

button.Click:Connect(function() widget.Enabled = not widget.Enabled end)
]]></ProtectedString></Properties><Item class="Folder" referent="F0"><Properties><string name="Name">Templates</string></Properties><Item class="ModuleScript" referent="T0"><Properties><string name="Name">ButtonFeel</string><ProtectedString name="Source"><![CDATA[-- ButtonFeel.lua — make every button feel alive (ModuleScript, require from a LocalScript).
-- version: 1
-- changelog: v1 2026-10-23 first version
-- local ButtonFeel = require(game.ReplicatedStorage.ButtonFeel)
-- ButtonFeel.Apply(button, { sound = true })        -- one button
-- ButtonFeel.ApplyAll(playerGui)                    -- every GuiButton under it (and new ones)
-- ButtonFeel.Deny(button)                           -- "not enough coins" shake

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local ButtonFeel = {}

local SOUNDS = { -- replace with your own uploaded ids
	hover = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/button.wav",
	deny  = "rbxasset://sounds/uuhhh.mp3",
}

local function play(id, vol)
	if not id then return end
	local s = Instance.new("Sound"); s.SoundId = id; s.Volume = vol or 0.4
	s.PlaybackSpeed = 1 + (math.random() - 0.5) * 0.1
	SoundService:PlayLocalSound(s); task.delay(2, function() s:Destroy() end)
end

local function scaleOf(btn)
	local sc = btn:FindFirstChild("FeelScale")
	if not sc then sc = Instance.new("UIScale"); sc.Name = "FeelScale"; sc.Parent = btn end
	return sc
end

local function tween(obj, t, style, props)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play(); return tw
end

function ButtonFeel.Apply(btn, opts)
	if btn:GetAttribute("Feel") then return end
	btn:SetAttribute("Feel", true)
	opts = opts or {}
	local sc = scaleOf(btn)
	local hoverScale, pressScale = opts.hover or 1.06, opts.press or 0.92
	local hovering = false
	local function over() hovering = true; tween(sc, 0.12, nil, { Scale = hoverScale }); if opts.sound ~= false then play(SOUNDS.hover, 0.2) end end
	local function out() hovering = false; tween(sc, 0.15, nil, { Scale = 1 }) end
	btn.MouseEnter:Connect(over); btn.MouseLeave:Connect(out)
	btn.SelectionGained:Connect(over); btn.SelectionLost:Connect(out)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.06, nil, { Scale = pressScale }) end)
	btn.Activated:Connect(function()
		tween(sc, 0.22, Enum.EasingStyle.Back, { Scale = hovering and hoverScale or 1 })
		if opts.sound ~= false then play(SOUNDS.click, 0.45) end
	end)
end

function ButtonFeel.ApplyAll(root, opts)
	for _, d in ipairs(root:GetDescendants()) do if d:IsA("GuiButton") then ButtonFeel.Apply(d, opts) end end
	root.DescendantAdded:Connect(function(d) if d:IsA("GuiButton") then ButtonFeel.Apply(d, opts) end end)
end

function ButtonFeel.Deny(btn)
	local start = btn.Position
	play(SOUNDS.deny, 0.4)
	task.spawn(function()
		for i = 1, 3 do
			tween(btn, 0.04, nil, { Position = start + UDim2.fromOffset(6, 0) }).Completed:Wait()
			tween(btn, 0.04, nil, { Position = start - UDim2.fromOffset(6, 0) }).Completed:Wait()
		end
		tween(btn, 0.05, nil, { Position = start })
	end)
end

-- Panel open/close with a CanvasGroup (one tween fades everything inside)
function ButtonFeel.Open(canvasGroup)
	local sc = scaleOf(canvasGroup); sc.Scale = 0.85; canvasGroup.GroupTransparency = 1; canvasGroup.Visible = true
	tween(sc, 0.3, Enum.EasingStyle.Back, { Scale = 1 }); tween(canvasGroup, 0.25, nil, { GroupTransparency = 0 })
end
function ButtonFeel.Close(canvasGroup)
	local sc = scaleOf(canvasGroup)
	tween(sc, 0.18, nil, { Scale = 0.9 })
	tween(canvasGroup, 0.18, nil, { GroupTransparency = 1 }).Completed:Wait()
	canvasGroup.Visible = false
end

return ButtonFeel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T1"><Properties><string name="Name">ConfirmToken</string><ProtectedString name="Source"><![CDATA[-- ConfirmToken.lua — preview → confirm → commit for item machines (fuse, craft, upgrade, enchant, trade-in).
-- version: 1
-- use: ModuleScript in ServerScriptService (server only). Put the RULES in a pure shared module so the
--      client can show the same preview offline; this module makes the real action safe:
--      * Preview returns a one-use token bound to (player, inputs, choice) that expires (default 120 s).
--      * Commit re-validates on live data, runs your mutation in ONE non-yielding call, and caches the
--        result per token: a repeated/lagged Commit returns the same result and never consumes twice.
--
-- local ConfirmToken = require(game.ServerScriptService.ConfirmToken)
-- local Fuse = ConfirmToken.new({
--     name = "Fuse",                 -- creates Remotes/FusePreview + Remotes/FuseCommit (RemoteFunctions)
--     maxInputs = 5,                 -- inputs = array of item id strings from the client
--     preview = function(player, inputs, choice)          -- may read data, must not change it
--         local data = Data.Get(player); if not data then return false, "loading" end
--         return FuseRules.Preview(data, inputs, choice)   -- -> true, previewInfo | false, reason
--     end,
--     commit = function(player, inputs, choice, previewInfo) -- MUST NOT YIELD (no waits, no DataStore calls)
--         local data = Data.Get(player); if not data then return false, "loading" end
--         local ok, why = FuseRules.Preview(data, inputs, choice)  -- re-check: items may be gone now
--         if not ok then return false, why end
--         return true, FuseRules.Apply(data, inputs, choice)       -- remove inputs, add result
--     end,
--     onCommitted = function(player, result) Data.SaveSoon(player, 6) end, -- may yield
-- })
-- Client: local ok, info, token = Remotes.FusePreview:InvokeServer(ids, "tierUp")
--         ...show info + Confirm button...  local ok2, result = Remotes.FuseCommit:InvokeServer(token)
--
-- changelog: v1 2026-10-24 first version (pattern from lyopz's projects: lessons → roblox-dev §2)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local ConfirmToken = {}
ConfirmToken.__index = ConfirmToken

local MAX_ID_LEN = 64
local MAX_CHOICE_LEN = 32

local function remotesFolder()
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	return f
end

local function makeRemote(name)
	local folder = remotesFolder()
	local r = folder:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteFunction")
		r.Name = name
		r.Parent = folder
	end
	return r
end

local function cleanString(s, maxLen)
	return type(s) == "string" and #s > 0 and #s <= maxLen and utf8.len(s) ~= nil
end

-- inputs: array of unique short strings, 1..maxInputs long. Returns a copy (never keep client tables).
local function cleanInputs(inputs, maxInputs)
	if type(inputs) ~= "table" then return nil end
	local n = #inputs
	if n < 1 or n > maxInputs then return nil end
	local out, seen, count = {}, {}, 0
	for k, v in pairs(inputs) do
		count = count + 1
		if type(k) ~= "number" or k % 1 ~= 0 or k < 1 or k > n then return nil end
		if not cleanString(v, MAX_ID_LEN) or seen[v] then return nil end
		seen[v] = true
		out[k] = v
	end
	if count ~= n then return nil end
	return out
end

-- Runs fn without allowing it to yield; a yield would let another request interleave with the mutation.
local function runNoYield(fn, ...)
	local co = coroutine.create(fn)
	local resumed, ok, result = coroutine.resume(co, ...)
	if not resumed then
		warn("[ConfirmToken] commit errored: " .. tostring(ok))
		return false, "error"
	end
	if coroutine.status(co) ~= "dead" then
		coroutine.close(co) -- never let a half-done mutation resume later
		warn("[ConfirmToken] commit yielded — move waits/DataStore calls to onCommitted")
		return false, "error"
	end
	return ok, result
end

function ConfirmToken.new(cfg)
	assert(type(cfg.name) == "string", "name required")
	assert(type(cfg.preview) == "function" and type(cfg.commit) == "function", "preview + commit required")
	local self = setmetatable({}, ConfirmToken)
	self.name = cfg.name
	self.ttl = cfg.ttl or 120
	self.maxInputs = cfg.maxInputs or 8
	self.minGap = cfg.minGap or 0.15 -- seconds between requests per player
	self.cfg = cfg
	self.tokens = {}   -- [player] = { [token] = { inputs, choice, info, expires, done, ok, result } }
	self.last = {}     -- [player] = os.clock() of last request

	local previewRemote = makeRemote(cfg.name .. "Preview")
	local commitRemote = makeRemote(cfg.name .. "Commit")
	previewRemote.OnServerInvoke = function(player, inputs, choice)
		return self:_preview(player, inputs, choice)
	end
	commitRemote.OnServerInvoke = function(player, token)
		return self:_commit(player, token)
	end
	Players.PlayerRemoving:Connect(function(player)
		self.tokens[player] = nil
		self.last[player] = nil
	end)
	return self
end

function ConfirmToken:_throttled(player)
	local now = os.clock()
	local last = self.last[player]
	if last and now - last < self.minGap then return true end
	self.last[player] = now
	return false
end

function ConfirmToken:_prune(player)
	local mine = self.tokens[player]
	if not mine then return end
	local now = os.clock()
	for t, rec in pairs(mine) do
		if rec.expires < now then mine[t] = nil end
	end
end

function ConfirmToken:_preview(player, inputs, choice)
	if self:_throttled(player) then return false, "slow down" end
	local clean = cleanInputs(inputs, self.maxInputs)
	if not clean then return false, "bad request" end
	if choice ~= nil and not cleanString(choice, MAX_CHOICE_LEN) then return false, "bad request" end
	local ok, info = self.cfg.preview(player, clean, choice)
	if not ok then return false, info end
	self:_prune(player)
	local mine = self.tokens[player] or {}
	self.tokens[player] = mine
	local count = 0
	for _ in pairs(mine) do count = count + 1 end
	if count >= 20 then return false, "slow down" end
	local token = HttpService:GenerateGUID(false)
	mine[token] = { inputs = clean, choice = choice, info = info, expires = os.clock() + self.ttl }
	return true, info, token
end

function ConfirmToken:_commit(player, token)
	if not cleanString(token, 40) then return false, "bad request" end
	local mine = self.tokens[player]
	local rec = mine and mine[token]
	if not rec then return false, "expired" end -- unknown, other player's, or pruned
	if rec.done then return rec.ok, rec.result end -- repeat click / retry: same answer, no second consume
	if rec.expires < os.clock() then
		mine[token] = nil
		return false, "expired"
	end
	local ok, result = runNoYield(self.cfg.commit, player, rec.inputs, rec.choice, rec.info)
	rec.done, rec.ok, rec.result = true, ok, result
	rec.expires = os.clock() + self.ttl -- keep the cached answer around for retries
	if ok then
		-- Invalidate every other open preview: they were computed on data that just changed.
		for t, other in pairs(mine) do
			if t ~= token and not other.done then mine[t] = nil end
		end
		if self.cfg.onCommitted then task.spawn(self.cfg.onCommitted, player, result) end
	end
	return ok, result
end

return ConfirmToken
]]></ProtectedString></Properties></Item><Item class="Script" referent="T2"><Properties><string name="Name">DevContentGuard</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- DevContentGuard (Script, put in ServerScriptService) — version: 1
-- Keeps dev-only stages (test labs, preview stands, debug tools) out of live games.
-- On LIVE servers (not RunService:IsStudio()) it destroys everything tagged "DevOnly" at startup, and anything
-- tagged later. In Studio (Edit, Play-in-Studio, local servers) nothing is touched, so the stages keep working.
-- Usage: tag each dev root with CollectionService tag "DevOnly" (Tag Editor, or CollectionService:AddTag(root, "DevOnly")).
-- Tags are lost when a stage is deleted and rebuilt: re-tag in your build code. Dev-only LocalScripts should
-- check RunService:IsStudio() first and return before any WaitForChild on dev content.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local TAG = "DevOnly"

if RunService:IsStudio() then return end

local removed = {}
for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
	if inst.Parent ~= nil then
		table.insert(removed, inst:GetFullName())
		pcall(function() inst:Destroy() end)
	end
end

CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
	task.defer(function()
		if inst.Parent ~= nil then pcall(function() inst:Destroy() end) end
	end)
end)

print(("[DevContentGuard] stripped %d dev-only root(s): %s"):format(#removed, table.concat(removed, ", ")))
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T3"><Properties><string name="Name">ImpactFX</string><ProtectedString name="Source"><![CDATA[-- ImpactFX.lua — physics impact feedback: thud sound + dust puff + optional callback, scaled by how hard things hit.
-- version: 1
-- use: local ImpactFX = require(game.ReplicatedStorage.ImpactFX)
--      local unbind = ImpactFX.Bind(crate, { sound = "rbxassetid://<thud id>", color = Color3.fromRGB(235, 225, 210) })
--      ImpactFX.BindTagged("ImpactFX", { sound = "rbxassetid://<id>" })  -- every part tagged "ImpactFX", now and later
--      options: sound, volume (0.6), color (dust), size (1), minSpeed (8), maxSpeed (60), cooldown (0.12 s per part),
--               dust (true), onImpact(info) where info = {part, other, point, normal, speed, strength 0..1, force}
-- where: summaries only exist on the part's NETWORK OWNER (not replicated). Server-owned loose props → require it in
--      a server Script (effects replicate). The player's own character/vehicle/tool → a LocalScript on that client.
--      Damage from onImpact: server-side only, on server-owned parts; never trust impacts reported by a client.
-- note: parts with CanCollide = false give no summaries. Cost grows with bound parts, so bind props that matter.
--      Falls back to Touched (rougher speed, no contact point) if BindToCollisionSummaries isn't available.
-- source: own code on Roblox's Collision Summaries API (BasePart:BindToCollisionSummaries, Oct 2026,
--      https://create.roblox.com/docs/workspace/collisions).
-- changelog: v1 2026-10-23 first version

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local ImpactFX = {}

local DUST = "rbxasset://textures/particles/smoke_main.dds"
local DEFAULTS = {
	volume = 0.6, color = Color3.fromRGB(235, 225, 210), size = 1,
	minSpeed = 8, maxSpeed = 60, cooldown = 0.12, dust = true,
}
local MAX_FX_PER_SECOND = 15 -- global cap so a pile of falling crates can't flood a phone
local budget, budgetTime = MAX_FX_PER_SECOND, os.clock()

local function takeBudget(): boolean
	local now = os.clock()
	budget = math.min(MAX_FX_PER_SECOND, budget + (now - budgetTime) * MAX_FX_PER_SECOND)
	budgetTime = now
	if budget < 1 then return false end
	budget -= 1
	return true
end

local function playFX(point: Vector3, outward: Vector3, strength: number, opts)
	local att = Instance.new("Attachment")
	att.Parent = workspace.Terrain -- parent BEFORE setting world coords, or they become local offsets
	att.WorldCFrame = CFrame.lookAt(point, point + outward)

	if opts.dust then
		local s = opts.size * (0.6 + strength)
		local e = Instance.new("ParticleEmitter")
		e.Enabled = false
		e.Texture = DUST
		e.LightEmission = 0 -- smoke/dust: no additive glow
		e.Color = ColorSequence.new(opts.color)
		e.Lifetime = NumberRange.new(0.35, 0.65)
		e.Speed = NumberRange.new(3 + 6 * strength, 6 + 10 * strength)
		e.EmissionDirection = Enum.NormalId.Front -- along `outward`
		e.SpreadAngle = Vector2.new(75, 75)
		e.Drag = 5
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5 * s),
			NumberSequenceKeypoint.new(1, 1.6 * s),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.Parent = att
		e:Emit(math.floor(4 + 10 * strength))
	end

	if opts.sound then
		local snd = Instance.new("Sound")
		snd.SoundId = opts.sound
		snd.Volume = opts.volume * (0.3 + 0.7 * strength)
		-- heavier hit = lower pitch, plus ±5% random so repeats don't sound copy-pasted
		snd.PlaybackSpeed = (1.1 - 0.2 * strength) * (0.95 + math.random() * 0.1)
		snd.RollOffMaxDistance = 90
		snd.Parent = att
		snd:Play()
	end

	Debris:AddItem(att, 3)
end

-- Binds one part. Returns a function that unbinds it.
function ImpactFX.Bind(part: BasePart, options: { [string]: any }?): () -> ()
	local opts = setmetatable(table.clone(options or {}), { __index = DEFAULTS })
	local last = 0

	local function handle(other: BasePart, point: Vector3, normal: Vector3, speed: number)
		if speed < opts.minSpeed then return end
		local now = os.clock()
		if now - last < opts.cooldown then return end
		last = now
		local strength = math.clamp((speed - opts.minSpeed) / math.max(opts.maxSpeed - opts.minSpeed, 1), 0, 1)
		-- Normal points away from `part` into `other`; dust sprays back out of the surface that was hit.
		if takeBudget() then playFX(point, -normal, strength, opts) end
		if opts.onImpact then
			task.spawn(opts.onImpact, {
				part = part, other = other, point = point, normal = normal,
				speed = speed, strength = strength, force = speed * part.AssemblyMass,
			})
		end
	end

	local ok, conn = pcall(function()
		return (part :: any):BindToCollisionSummaries(function(summaries)
			-- one callback per frame with every contact; keep only the hardest hit
			local best, bestSpeed = nil, 0
			for _, s in summaries do
				local sp = math.abs(s.RelativeVelocity:Dot(s.Normal))
				if sp > bestSpeed then best, bestSpeed = s, sp end
			end
			if best then handle(best.Part1, best.Point, best.Normal, bestSpeed) end
		end)
	end)

	if not ok then -- fallback: Touched (no contact data, so approximate)
		conn = part.Touched:Connect(function(other)
			local rel = part.AssemblyLinearVelocity - other.AssemblyLinearVelocity
			local dir = (other.Position - part.Position)
			local normal = if dir.Magnitude > 0 then dir.Unit else Vector3.new(0, -1, 0)
			handle(other, part.Position + normal * (part.Size.Magnitude * 0.25), normal, rel.Magnitude)
		end)
	end

	local destroying
	local function unbind()
		if conn then conn:Disconnect(); conn = nil end
		if destroying then destroying:Disconnect(); destroying = nil end
	end
	destroying = part.Destroying:Connect(unbind)
	return unbind
end

-- Binds every BasePart with `tag` (now and when added later); unbinds when the tag is removed.
function ImpactFX.BindTagged(tag: string, options: { [string]: any }?): () -> ()
	local bound: { [Instance]: () -> () } = {}
	local function add(inst: Instance)
		if inst:IsA("BasePart") and not bound[inst] then bound[inst] = ImpactFX.Bind(inst, options) end
	end
	local function remove(inst: Instance)
		if bound[inst] then bound[inst](); bound[inst] = nil end
	end
	for _, inst in CollectionService:GetTagged(tag) do add(inst) end
	local a = CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	local r = CollectionService:GetInstanceRemovedSignal(tag):Connect(remove)
	return function()
		a:Disconnect(); r:Disconnect()
		for inst, unbind in bound do unbind() end
		table.clear(bound)
	end
end

return ImpactFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T4"><Properties><string name="Name">Motion</string><ProtectedString name="Source"><![CDATA[-- motion.lua — scripted movement for Roblox models that don't need a rig (ModuleScript).
-- version: 1
-- changelog: v1 2026-10-23 first version
-- local Motion = require(game.ReplicatedStorage.Motion)
-- Motion.Spin(coin, 90)            -- degrees per second
-- Motion.Bob(pickup, 0.6, 1.5)     -- height (studs), seconds per cycle
-- Motion.Follow(pet, player, Vector3.new(3, 1, 3))
-- Motion.Waddle(model, 6)          -- cheap "walking" wobble for simple creatures moving between points

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Motion = {}

local function pivotOf(m) return m:IsA("Model") and m:GetPivot() or m.CFrame end
local function setPivot(m, cf) if m:IsA("Model") then m:PivotTo(cf) else m.CFrame = cf end end

function Motion.Spin(obj, degPerSec)
	local base = pivotOf(obj)
	local a = 0
	return RunService.Heartbeat:Connect(function(dt)
		a += math.rad(degPerSec or 90) * dt
		setPivot(obj, base * CFrame.Angles(0, a, 0))
	end)
end

function Motion.Bob(obj, height, period)
	local base = pivotOf(obj); local t = 0
	return RunService.Heartbeat:Connect(function(dt)
		t += dt
		setPivot(obj, base + Vector3.new(0, math.sin(t / (period or 1.5) * math.pi * 2) * (height or 0.5), 0))
	end)
end

-- Smooth pet follow (run on the client for the owner, or server for everyone)
function Motion.Follow(obj, player, offset)
	offset = offset or Vector3.new(3, 0, 3)
	local t = 0
	return RunService.Heartbeat:Connect(function(dt)
		local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		t += dt
		local target = hrp.CFrame * CFrame.new(offset) * CFrame.new(0, math.sin(t * 4) * 0.25, 0)
		local cur = pivotOf(obj)
		setPivot(obj, cur:Lerp(target, math.clamp(dt * 8, 0, 1)))
	end)
end

-- Move between points with a body waddle (fake walk for simple creatures, no animation needed)
function Motion.Waddle(model, speed, points)
	speed = speed or 6
	task.spawn(function()
		local i = 1
		while model.Parent do
			local from = pivotOf(model); local to = points[i]
			local dist = (to - from.Position).Magnitude
			local t, dur = 0, dist / speed
			while t < dur and model.Parent do
				t += RunService.Heartbeat:Wait()
				local p = math.clamp(t / dur, 0, 1)
				local pos = from.Position:Lerp(to, p)
				local sway = math.sin(t * speed * 2) * 0.12
				local hop = math.abs(math.sin(t * speed * 2)) * 0.25
				setPivot(model, CFrame.lookAt(pos, Vector3.new(to.X, pos.Y, to.Z)) * CFrame.new(0, hop, 0) * CFrame.Angles(0, 0, sway))
			end
			i = i % #points + 1
		end
	end)
end

-- Satisfying pickup: scale pop + fly up + fade (use on coins/orbs when collected)
function Motion.Collect(part)
	local info = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(part, info, { Size = part.Size * 1.6, CFrame = part.CFrame + Vector3.new(0, 3, 0), Transparency = 1 }):Play()
	game:GetService("Debris"):AddItem(part, 0.4)
end

return Motion
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="T5"><Properties><string name="Name">OceanClient</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- OceanClient: animated Gerstner ocean, things floating on it, and swaying palms.
-- version: 1
-- changelog: v1 2026-10-23 first version
-- Tags: "FloatOnWaves" (Model; optional attributes BobScale, Length, Width; its pivot's
-- LookVector = bow direction), "Sway" (Model; optional attribute SwayDegrees).
-- Needs Waves + OceanMesh in ReplicatedStorage. Terrain water should fill to y = 0 for swimming.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local RS = game:GetService("ReplicatedStorage")
local Waves = require(RS:WaitForChild("Waves"))
local OceanMesh = require(RS:WaitForChild("OceanMesh"))

local holder = Instance.new("Folder")
holder.Name = "OceanLocal"
holder.Parent = workspace
local ok, ocean = pcall(OceanMesh.Build, holder, Waves.Now())
if not ok then
	-- EditableMesh disabled for this experience: the saved terrain water stays visible
	warn("[OceanClient] mesh ocean unavailable: " .. tostring(ocean))
	ocean = nil
	Waves.Lift = 0
else
	OceanMesh.HideTerrainWater()
end

-- floating models: remember their rest pose once
local floaters = {}
local function addFloater(m)
	if not m:IsA("Model") or floaters[m] then return end
	local cf, size = m:GetBoundingBox()
	local pivot = m:GetPivot()
	floaters[m] = {
		rest = pivot,
		look = Vector3.new(pivot.LookVector.X, 0, pivot.LookVector.Z).Unit,
		length = m:GetAttribute("Length") or size.Z * 0.4,
		width = m:GetAttribute("Width") or size.X * 0.35,
		bob = m:GetAttribute("BobScale") or 0.8,
	}
end
for _, m in ipairs(CollectionService:GetTagged("FloatOnWaves")) do addFloater(m) end
CollectionService:GetInstanceAddedSignal("FloatOnWaves"):Connect(addFloater)

local swayers = {}
local function addSway(m)
	if not m:IsA("Model") or swayers[m] then return end
	local cf, size = m:GetBoundingBox()
	local pivot = m:GetPivot()
	local base = Vector3.new(cf.Position.X, cf.Position.Y - size.Y / 2, cf.Position.Z)
	swayers[m] = { rest = pivot, base = base, phase = math.random() * 10, amp = math.rad(m:GetAttribute("SwayDegrees") or 1.6) }
end
for _, m in ipairs(CollectionService:GetTagged("Sway")) do addSway(m) end
CollectionService:GetInstanceAddedSignal("Sway"):Connect(addSway)

local frame = 0
local stride, updates, avg = 1, 0, 0
RunService.Heartbeat:Connect(function()
	local t = Waves.Now()
	frame += 1
	-- ocean: adaptive rate. Every frame on fast devices; every 2nd/3rd frame if updates get
	-- expensive (phones). Foam colors refresh on every 3rd update.
	if ocean and frame % stride == 0 then
		local c0 = os.clock()
		updates += 1
		ocean.Update(t, updates % 3 == 0)
		local cost = os.clock() - c0
		avg = avg * 0.9 + cost * 0.1
		if avg > 0.006 then stride = 3 elseif avg > 0.0035 then stride = 2 else stride = 1 end
	end

	for m, f in pairs(floaters) do
		if not m.Parent then floaters[m] = nil; continue end
		local p = f.rest.Position
		local fwd, right = f.look, f.look:Cross(Vector3.yAxis)
		local hc = Waves.Height(p.X, p.Z, t)
		local hb = Waves.Height(p.X + fwd.X * f.length, p.Z + fwd.Z * f.length, t)
		local hs = Waves.Height(p.X - fwd.X * f.length, p.Z - fwd.Z * f.length, t)
		local hr = Waves.Height(p.X + right.X * f.width, p.Z + right.Z * f.width, t)
		local hl = Waves.Height(p.X - right.X * f.width, p.Z - right.Z * f.width, t)
		local pitch = math.atan2(hb - hs, 2 * f.length) * f.bob
		local roll = math.atan2(hr - hl, 2 * f.width) * f.bob
		local rot = f.rest - f.rest.Position
		m:PivotTo(CFrame.new(p + Vector3.new(0, (hc - Waves.SeaLevel) * f.bob, 0)) * rot * CFrame.Angles(pitch, 0, -roll))
	end

	for m, s in pairs(swayers) do
		if not m.Parent then swayers[m] = nil; continue end
		local a = s.amp * math.sin(t * 0.9 + s.phase) + s.amp * 0.4 * math.sin(t * 2.1 + s.phase * 1.7)
		local b = s.amp * 0.6 * math.cos(t * 0.7 + s.phase)
		local hinge = CFrame.new(s.base)
		m:PivotTo(hinge * CFrame.Angles(b, 0, a) * hinge:Inverse() * s.rest)
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T6"><Properties><string name="Name">OceanMesh</string><ProtectedString name="Source"><![CDATA[-- OceanMesh: builds a radial EditableMesh ocean around Waves.Center and animates it.
-- version: 1
-- changelog: v1 2026-10-23 first version
-- Dense rings near the island, wide rings out to the horizon (flat there, hidden by haze).
-- Usage (client): local o = OceanMesh.Build(folder, Waves.Now()); each frame o.Update(Waves.Now(), doColor)
-- Edit-time preview: Build into workspace.OceanPreview and delete it on server start
-- (the EditableMesh content isn't saved with the place).
-- Lessons: max mesh extent is 2048 studs (FAR_RADIUS 1020); the MeshPart keeps the size it was
-- created with, so two hidden triangles lock the height range; vertex colors get multiplied by
-- Lighting.Brightness, so use dark base colors in bright presets.
local AssetService = game:GetService("AssetService")
local Waves = require(script.Parent:WaitForChild("Waves"))

local OceanMesh = {}

local SEGMENTS = 120
local NEAR_STEP = 5        -- radial spacing near the island
local NEAR_RADIUS = 260
local FAR_RADIUS = 1020
local FAR_RINGS = 12
local ANIMATE_RADIUS = Waves.FadeEnd + 50

-- tuned for the bright cartoon preset (Brightness 3); brighten for darker lighting
local SHALLOW = Color3.fromRGB(18, 95, 100)
local MID = Color3.fromRGB(6, 48, 85)
local DEEP = Color3.fromRGB(3, 24, 55)
local SHORE_FOAM = Color3.fromRGB(150, 160, 160)

local function depthColor(r)
	if r < 50 then return SHALLOW end
	if r < 110 then return SHALLOW:Lerp(MID, (r - 50) / 60) end
	if r < 320 then return MID:Lerp(DEEP, (r - 110) / 210) end
	return DEEP
end

function OceanMesh.Build(parent: Instance, t: number?)
	local em = AssetService:CreateEditableMesh({ FixedSize = false })
	local radii = { 0 }
	local r = 0
	while r < NEAR_RADIUS do r += NEAR_STEP; table.insert(radii, r) end
	local grow = (FAR_RADIUS / NEAR_RADIUS) ^ (1 / FAR_RINGS)
	for _ = 1, FAR_RINGS do r *= grow; table.insert(radii, r) end

	local cx, cz = Waves.Center.X, Waves.Center.Y
	-- { vid, cid, bx, bz, strength, base color, animate, nid, island shape }
	local verts = {}
	local rings = {}
	for ri, rad in ipairs(radii) do
		local ring = {}
		local count = (rad == 0) and 1 or SEGMENTS
		for s = 0, count - 1 do
			local a = s / SEGMENTS * math.pi * 2
			local bx, bz = cx + math.cos(a) * rad, cz + math.sin(a) * rad
			local vid = em:AddVertex(Vector3.new(bx, Waves.SeaLevel, bz))
			local base = depthColor(rad)
			local cid = em:AddColor(base, 1)
			local nid = em:AddNormal(Vector3.yAxis)
			local v = { vid, cid, bx, bz, Waves.Strength(bx, bz), base, rad <= ANIMATE_RADIUS, nid, Waves.IslandShape(bx, bz) }
			table.insert(verts, v)
			table.insert(ring, v)
		end
		rings[ri] = ring
	end
	local function tri(a, b, c)
		local f = em:AddTriangle(a[1], b[1], c[1])
		em:SetFaceColors(f, { a[2], b[2], c[2] })
		em:SetFaceNormals(f, { a[8], b[8], c[8] })
	end
	-- center fan
	local c0 = rings[1][1]
	for s = 1, SEGMENTS do
		local a, b = rings[2][s], rings[2][s % SEGMENTS + 1]
		tri(c0, b, a)
	end
	for ri = 2, #rings - 1 do
		local A, B = rings[ri], rings[ri + 1]
		for s = 1, SEGMENTS do
			local s2 = s % SEGMENTS + 1
			tri(A[s], B[s2], B[s])
			tri(A[s], A[s2], B[s2])
		end
	end

	-- two tiny hidden triangles under the island lock the mesh height to +-8 studs,
	-- so wave motion never gets rescaled by the MeshPart's fixed size
	for _, y in ipairs({ 8, -8 }) do
		local p = Vector3.new(cx, Waves.SeaLevel + y, cz)
		local a = em:AddVertex(p); local b = em:AddVertex(p + Vector3.new(0.01, 0, 0)); local c = em:AddVertex(p + Vector3.new(0, 0, 0.01))
		em:AddTriangle(a, c, b)
	end

	local part = AssetService:CreateMeshPartAsync(Content.fromObject(em))
	part.Name = "Ocean"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Transparency = 0.1
	part.Reflectance = 0.1
	part.Color = Color3.new(1, 1, 1)
	part.Parent = parent

	-- only vertices that actually move get updated each frame
	local live = {}
	for _, v in ipairs(verts) do if v[7] and v[5] > 0 then table.insert(live, v) end end

	local self = { Part = part, Mesh = em, Live = live, VertCount = #verts }
	function self.Update(time: number, doColor: boolean?)
		for _, v in ipairs(live) do
			local dx, dy, dz, nx, ny, nz = Waves.DisplaceNormal(v[3], v[4], time, v[5])
			em:SetPosition(v[1], Vector3.new(v[3] + dx, Waves.SeaLevel + dy, v[4] + dz))
			em:SetNormal(v[8], Vector3.new(nx, ny, nz).Unit)
			if doColor then
				local crest = math.clamp((dy - (Waves.MaxAmplitude * Waves.Lift * v[5]) - 1.1) / 1.1, 0, 1)
				-- shore foam: a band at the waterline that pulses like breaking waves
				local s = v[9]
				if s > 0.8 and s < 1.25 then
					local band = 1 - math.abs(s - 0.97) / 0.2
					if band > 0 then
						local pulse = 0.55 + 0.45 * math.sin(time * 1.7 - s * 28)
						crest = math.max(crest, band * pulse)
					end
				end
				em:SetColor(v[2], crest > 0 and v[6]:Lerp(SHORE_FOAM, crest * 0.9) or v[6])
			end
		end
	end
	if t then self.Update(t, true) end
	-- the mesh position is baked in world space; keep the part at the origin
	part.CFrame = CFrame.new()
	return self
end

-- Terrain water fills to sea level (for swimming). When the mesh ocean is running, hide the
-- terrain water surface on this client; otherwise leave the saved terrain-water look.
function OceanMesh.HideTerrainWater()
	local T = workspace.Terrain
	T.WaterTransparency = 1
	T.WaterReflectance = 0
	T.WaterWaveSize = 0
end

return OceanMesh
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T7"><Properties><string name="Name">PetFX</string><ProtectedString name="Source"><![CDATA[-- PetFX.lua — pet/reward effects for simulators (ModuleScript in ReplicatedStorage, call from the CLIENT).
-- version: 1
-- changelog: v1 2026-10-24 first version (hatch, rarity aura, level up, reward fountain, light pillar, trail, Play, culling)
-- Uses Roblox's built-in particle textures, so it works with no uploads. Swap the TEX ids for your own
-- (ChatGPT white-on-black textures, see roblox-vfx/references/textures.md) to match the game's style.
-- Usage (LocalScript):
--   local PetFX = require(game.ReplicatedStorage.PetFX)
--   PetFX.HatchInFront(eggModel, "Legendary", function(cf) --[[show the pet at cf]] end)
--   local stop = PetFX.RarityAura(pet.PrimaryPart, "Mythic")   -- stop() removes it
--   PetFX.LevelUp(player.Character)
--   PetFX.Reward(chest:GetPivot().Position, "Coins", 20)
--   local pillar = PetFX.Pillar(egg:GetPivot().Position, "Legendary", 40)
--   PetFX.Trail(pet.PrimaryPart, "Epic")
--   PetFX.Play(workspace.SomeEffect)     -- emits every emitter using EmitCount / EmitDelay attributes
--   PetFX.Cull(workspace.Pets, 120)      -- turns pet effects off beyond 120 studs from the camera
-- Everything here is cosmetic: the server decides the pet/reward, then tells the client to play it.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

local PetFX = {}

local TEX = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Ring = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	Shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}
PetFX.Textures = TEX -- overwrite entries from your game to restyle every effect

-- Same rarity colors everywhere (roblox-design/references/pets-and-eggs.md). Tier drives how big effects get.
PetFX.Rarity = {
	Common = { Color = Color3.fromRGB(190, 190, 200), Tier = 1 },
	Uncommon = { Color = Color3.fromRGB(80, 220, 100), Tier = 2 },
	Rare = { Color = Color3.fromRGB(60, 150, 255), Tier = 3 },
	Epic = { Color = Color3.fromRGB(170, 80, 255), Tier = 4 },
	Legendary = { Color = Color3.fromRGB(255, 200, 40), Tier = 5 },
	Mythic = { Color = Color3.fromRGB(255, 50, 90), Tier = 6 },
	Secret = { Color = Color3.fromRGB(255, 255, 255), Tier = 7, Rainbow = true },
	Coins = { Color = Color3.fromRGB(255, 205, 50), Tier = 3 },
	Gems = { Color = Color3.fromRGB(80, 230, 255), Tier = 3 },
}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 60)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 255, 120)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(60, 160, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 80, 255)),
})

-- Quality: 1 = full. Low graphics settings / phones get fewer particles automatically.
local quality = 1
do
	local ok, level = pcall(function() return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value end)
	if ok and level > 0 and level <= 3 then quality = 0.5 end -- Automatic = 0, 1..10 = manual slider
	if game:GetService("UserInputService").TouchEnabled then quality = math.min(quality, 0.7) end
end
function PetFX.SetQuality(q: number) quality = math.clamp(q, 0.1, 1) end
local function n(count: number): number return math.max(1, math.floor(count * quality + 0.5)) end

local function info(rarity: string?)
	return PetFX.Rarity[rarity or "Common"] or PetFX.Rarity.Common
end
local function colorOf(rarity: string?): ColorSequence
	local r = info(rarity)
	if r.Rainbow then return RAINBOW end
	return ColorSequence.new(Color3.new(1, 1, 1):Lerp(r.Color, 0.35), r.Color) -- white-hot start, rarity color end
end
local function seq(...: number): NumberSequence
	local a, k = { ... }, {}
	for i = 1, #a, 2 do table.insert(k, NumberSequenceKeypoint.new(a[i], a[i + 1])) end
	return NumberSequence.new(k)
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	e.LightEmission = 1 -- additive glow; set 0 for smoke/dust
	e.Rate = 0 -- bursts by default, continuous effects set Rate
	for k, v in props do (e :: any)[k] = v end
	e.Parent = parent
	return e
end

-- Invisible anchored holder part at a position (effects need a part or attachment)
local function holder(pos: Vector3, life: number?): (BasePart, Attachment)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency, p.Size, p.Position = 1, Vector3.one, pos
	p.Parent = workspace.CurrentCamera or workspace -- under Camera = only this client sees it
	local att = Instance.new("Attachment"); att.Parent = p
	if life then Debris:AddItem(p, life) end
	return p, att
end

local function light(att: Instance, color: Color3, range: number, brightness: number, fade: number?)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, false
	l.Parent = att
	if fade then TweenService:Create(l, TweenInfo.new(fade), { Brightness = 0 }):Play() end
	return l
end

-- Burst: flash + shockwave ring + sparks + glow motes. The building block of hatches and rewards.
function PetFX.Burst(pos: Vector3, rarity: string?, scale: number?)
	local s, r = scale or 1, info(rarity)
	local t = r.Tier
	local _, att = holder(pos, 3)
	local col = colorOf(rarity)
	emitter(att, { Name = "Flash", Texture = TEX.Glow, Lifetime = NumberRange.new(0.15, 0.2), Speed = NumberRange.new(0),
		Size = seq(0, 2 * s, 0.3, 6 * s, 1, 7 * s), Transparency = seq(0, 0, 1, 1), Color = col, ZOffset = 2, Brightness = 2 }):Emit(1)
	emitter(att, { Name = "Shock", Texture = TEX.Shock, Lifetime = NumberRange.new(0.35, 0.45), Speed = NumberRange.new(0.01),
		Orientation = Enum.ParticleOrientation.VelocityPerpendicular, EmissionDirection = Enum.NormalId.Top,
		Size = seq(0, 1 * s, 1, (6 + t) * s), Transparency = seq(0, 0.1, 1, 1), Color = col }):Emit(1)
	emitter(att, { Name = "Sparks", Texture = TEX.Spark, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(14 * s, 28 * s),
		SpreadAngle = Vector2.new(180, 180), Drag = 5, Acceleration = Vector3.new(0, -12, 0), Squash = seq(0, 1.5, 1, 0),
		Size = seq(0, 0.5 * s, 1, 0), Color = col }):Emit(n(10 + t * 6))
	emitter(att, { Name = "Motes", Texture = TEX.Glow, Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(3 * s, 7 * s),
		SpreadAngle = Vector2.new(180, 180), Drag = 2, Acceleration = Vector3.new(0, 3, 0),
		Size = seq(0, 0.4 * s, 0.5, 0.3 * s, 1, 0), Transparency = seq(0, 0, 0.7, 0.2, 1, 1), Color = col }):Emit(n(4 + t * 2))
	light(att, r.Color, 14 * s + t * 2, 3 + t * 0.5, 0.6)
end

-- Rarity aura on a pet: flat ground ring + rising motes + soft light. Rates grow with tier.
-- Returns a stop() function. Common/Uncommon get nothing (keeps rare pets special and saves FPS).
function PetFX.RarityAura(part: BasePart, rarity: string, scale: number?): () -> ()
	local r, s = info(rarity), scale or math.max(part.Size.X, part.Size.Z) / 2
	if r.Tier < 3 then return function() end end
	local col = colorOf(rarity)
	local att = Instance.new("Attachment"); att.Name = "PetFXAura"; att.Parent = part
	att.Position = Vector3.new(0, -part.Size.Y / 2, 0)
	emitter(att, { Name = "Ring", Texture = TEX.Ring, Rate = 1.5, Lifetime = NumberRange.new(1.2), Speed = NumberRange.new(0.01),
		Orientation = Enum.ParticleOrientation.VelocityPerpendicular, EmissionDirection = Enum.NormalId.Top, ZOffset = 0,
		RotSpeed = NumberRange.new(60), Size = seq(0, 1.8 * s, 1, 2.4 * s), Transparency = seq(0, 1, 0.3, 0.4, 1, 1),
		Color = col, LockedToPart = true })
	emitter(att, { Name = "Motes", Texture = TEX.Spark, Rate = n(2 + r.Tier * 1.5), Lifetime = NumberRange.new(0.9, 1.6),
		Speed = NumberRange.new(1.5), SpreadAngle = Vector2.new(25, 25), Drag = 0, Acceleration = Vector3.new(0, 2, 0),
		EmissionDirection = Enum.NormalId.Top, Size = seq(0, 0, 0.2, 0.35 * s, 1, 0), Color = col })
	if r.Tier >= 5 then light(att, r.Color, 8 * s, 1.2) end
	return function() att:Destroy() end
end

-- Trail behind a moving pet/player part (Epic+ pets, speed boosts, dashes)
function PetFX.Trail(part: BasePart, rarity: string?, width: number?): Trail
	local w = width or part.Size.Y * 0.8
	local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, w / 2, 0); a0.Parent = part
	local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -w / 2, 0); a1.Parent = part
	local t = Instance.new("Trail")
	t.Attachment0, t.Attachment1 = a0, a1
	t.Lifetime, t.MinLength, t.FaceCamera, t.LightEmission, t.LightInfluence = 0.35, 0.1, true, 1, 0
	t.Color = colorOf(rarity)
	t.Transparency = seq(0, 0.2, 1, 1)
	t.WidthScale = seq(0, 1, 1, 0) -- taper to a point
	t.Parent = part
	return t
end

-- Light pillar: a vertical beam over an egg/drop/landmark. Two beams (core + soft halo) facing the camera.
function PetFX.Pillar(pos: Vector3, rarity: string?, height: number?): BasePart
	local h, r = height or 30, info(rarity)
	local p, bottom = holder(pos)
	local top = Instance.new("Attachment"); top.Position = Vector3.new(0, h, 0); top.Parent = p
	local function beam(width: number, transp: number)
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1 = bottom, top
		b.FaceCamera, b.LightEmission, b.LightInfluence, b.Segments = true, 1, 0, 1
		b.Width0, b.Width1 = width, width * 0.6
		b.Color = colorOf(rarity)
		b.Transparency = seq(0, transp, 0.7, transp + 0.3 * (1 - transp), 1, 1) -- fades out at the top
		b.Parent = p
	end
	beam(1.2 + r.Tier * 0.2, 0.1)
	beam(4 + r.Tier * 0.5, 0.75)
	emitter(bottom, { Name = "Rise", Texture = TEX.Spark, Rate = n(6), Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(h / 3, h / 2), SpreadAngle = Vector2.new(3, 3), EmissionDirection = Enum.NormalId.Top,
		Size = seq(0, 0.4, 1, 0), Color = colorOf(rarity) })
	return p -- Destroy() it to remove
end

-- Reward fountain: coins/gems pop up and fall, plus a burst. Use the reward's texture for the coins if you have one.
function PetFX.Reward(pos: Vector3, kind: string?, count: number?, texture: string?)
	local k = kind or "Coins"
	PetFX.Burst(pos, k, 0.7)
	local _, att = holder(pos, 3)
	emitter(att, { Name = "Coins", Texture = texture or TEX.Spark, Lifetime = NumberRange.new(1, 1.4),
		Speed = NumberRange.new(14, 22), SpreadAngle = Vector2.new(30, 30), EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -45, 0), RotSpeed = NumberRange.new(-180, 180), Rotation = NumberRange.new(0, 360),
		Size = seq(0, 0.9, 1, 0.6), Transparency = seq(0, 0, 0.85, 0, 1, 1), Color = colorOf(k),
		LightEmission = texture and 0 or 1 }):Emit(n(count or 16))
end

-- Level up / rebirth: ground shockwave + spiral column of motes + bright flash on the character.
function PetFX.LevelUp(character: Model, rarity: string?)
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local key = rarity or "Legendary"
	local feet = root.Position - Vector3.new(0, 3, 0)
	PetFX.Burst(feet, key, 1)
	local att = Instance.new("Attachment"); att.Position = Vector3.new(0, -3, 0); att.Parent = root
	local col = colorOf(key)
	local column = emitter(att, { Name = "Column", Texture = TEX.Spark, Rate = n(40), Lifetime = NumberRange.new(0.8, 1.2),
		Speed = NumberRange.new(6, 9), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(12, 12),
		RotSpeed = NumberRange.new(200), Size = seq(0, 0.5, 1, 0), Color = col, LockedToPart = true })
	emitter(att, { Name = "Glow", Texture = TEX.Glow, Lifetime = NumberRange.new(0.6), Speed = NumberRange.new(0.01),
		EmissionDirection = Enum.NormalId.Top, Size = seq(0, 3, 0.5, 6, 1, 4), Transparency = seq(0, 0.3, 1, 1),
		Color = col, LockedToPart = true }):Emit(1)
	local l = light(att, info(key).Color, 16, 4, 1.2)
	task.delay(0.6, function() column.Enabled = false end)
	Debris:AddItem(att, 2)
	return l
end

-- Screen flash (white by default) for hatches/big rewards. Keep it short; offer a setting to turn it off.
function PetFX.Flash(color: Color3?, duration: number?)
	local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	local gui = Instance.new("ScreenGui"); gui.IgnoreGuiInset, gui.DisplayOrder, gui.ResetOnSpawn = true, 50, false
	local f = Instance.new("Frame"); f.Size = UDim2.fromScale(1, 1); f.BorderSizePixel = 0
	f.BackgroundColor3 = color or Color3.new(1, 1, 1); f.BackgroundTransparency = 0.1; f.Parent = gui
	gui.Parent = pg
	TweenService:Create(f, TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }):Play()
	Debris:AddItem(gui, (duration or 0.35) + 0.1)
end

-- Hatch an egg in front of the camera (no ViewportFrame: particles don't render inside ViewportFrames).
-- egg: a Model or part to clone. onReveal(cf) is called at the crack with the CFrame to place the pet at.
-- Returns the total time so the caller can wait. Legendary+ get a longer build-up, light pillar and bloom pulse.
function PetFX.HatchInFront(egg: PVInstance, rarity: string, onReveal: ((CFrame) -> ())?, distance: number?): number
	local cam = workspace.CurrentCamera
	local r = info(rarity)
	local big = r.Tier >= 5
	local shakeTime = big and 2.2 or 1.4
	local dist = distance or 9
	local clone = egg:Clone() :: PVInstance
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = true, false, false, false end
		if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
	end
	if clone:IsA("BasePart") then clone.Anchored, clone.CanCollide = true, false end
	clone.Parent = cam
	local blur = Instance.new("BlurEffect"); blur.Size = 0; blur.Parent = Lighting
	TweenService:Create(blur, TweenInfo.new(0.4), { Size = 12 }):Play()
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local base = cam.CFrame * CFrame.new(0, 0, -dist) * CFrame.Angles(0, math.pi, 0)
		local lift = math.min(t / 0.5, 1) -- rise into view
		local p = math.clamp(t / shakeTime, 0, 1)
		local amp = math.rad(4 + 22 * p * p) -- each shake stronger
		local freq = 10 + 25 * p -- and faster
		local wobble = math.sin(t * freq) * amp * lift
		clone:PivotTo(base * CFrame.new(0, (1 - lift) * -4, 0) * CFrame.Angles(0, 0, wobble))
	end)
	task.delay(shakeTime, function()
		conn:Disconnect()
		local cf = cam.CFrame * CFrame.new(0, 0, -dist) * CFrame.Angles(0, math.pi, 0)
		clone:Destroy()
		PetFX.Flash(big and r.Color:Lerp(Color3.new(1, 1, 1), 0.6) or nil, big and 0.6 or 0.3)
		PetFX.Burst(cf.Position, rarity, big and 1.4 or 1)
		if big then
			local bloom = Instance.new("BloomEffect"); bloom.Intensity, bloom.Size, bloom.Threshold = 1.5, 40, 0.8
			bloom.Parent = Lighting
			TweenService:Create(bloom, TweenInfo.new(1), { Intensity = 0 }):Play()
			Debris:AddItem(bloom, 1.1)
			local pillar = PetFX.Pillar(cf.Position - Vector3.new(0, 3, 0), rarity, 12)
			Debris:AddItem(pillar, 2.5)
		end
		if onReveal then task.spawn(onReveal, cf) end
		TweenService:Create(blur, TweenInfo.new(0.8), { Size = 0 }):Play()
		Debris:AddItem(blur, 0.9)
	end)
	return shakeTime + 1.2
end

-- Play a prebuilt effect (a Model/Folder/Attachment made in Studio or with a VFX plugin).
-- Reads the common VFX-plugin attributes on each emitter: EmitCount (default 10), EmitDelay (s), EmitDuration (s, keeps it on).
function PetFX.Play(effect: Instance)
	for _, d in effect:GetDescendants() do
		if d:IsA("ParticleEmitter") then
			local count = d:GetAttribute("EmitCount") or 10
			local delay = d:GetAttribute("EmitDelay") or 0
			local dur = d:GetAttribute("EmitDuration")
			task.delay(delay, function()
				if dur then
					d.Enabled = true
					task.delay(dur, function() d.Enabled = false end)
				else
					d:Emit(n(count))
				end
			end)
		elseif d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") then
			local dur = d:GetAttribute("EmitDuration")
			if dur then
				task.delay(d:GetAttribute("EmitDelay") or 0, function()
					d.Enabled = true
					task.delay(dur, function() d.Enabled = false end)
				end)
			end
		end
	end
end

-- Turn emitters/beams/trails/lights under `container` off when far from the camera (checks twice a second).
-- Remembers each one's own Enabled so effects that were off stay off. Returns a stop() function.
function PetFX.Cull(container: Instance, maxDistance: number?): () -> ()
	local maxD = maxDistance or 120
	local wanted: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any -- weak: destroyed effects drop out
	local running = true
	task.spawn(function()
		while running do
			local camPos = workspace.CurrentCamera.CFrame.Position
			for _, d in container:GetDescendants() do
				if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") then
					if wanted[d] == nil then wanted[d] = (d :: any).Enabled end
					local at = d:FindFirstAncestorWhichIsA("BasePart")
					local near = at ~= nil and (at.Position - camPos).Magnitude <= maxD
					local on = near and wanted[d]
					if (d :: any).Enabled ~= on then (d :: any).Enabled = on end
				end
			end
			task.wait(0.5)
		end
	end)
	return function() running = false end
end

return PetFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T8"><Properties><string name="Name">PortalFX</string><ProtectedString name="Source"><![CDATA[-- PortalFX.lua — animated themed portals: spinning swirl, swirling particles, falling code rain, glow pulse.
-- version: 1
-- changelog: v1 2026-10-24 first version (Swirl, SwirlParticles, CodeRain, CodeCurtain, GlowPulse, client Animate)
-- ModuleScript in ReplicatedStorage. Build* functions run anywhere (server or Studio edit, via execute_luau) and only
-- create instances + CollectionService tags. PortalFX.Animate() runs on the CLIENT (one LocalScript) and moves
-- everything tagged, only while the camera is near (cheap on phones). No textures needed: built-in particle textures
-- and Text for the code rain. Pass your own texture ids in opts to match the game's style.
-- Usage (server / edit time):
--   local PortalFX = require(game.ReplicatedStorage.PortalFX)
--   PortalFX.Swirl(portal.PortalFill, {Color = Color3.fromRGB(80,255,120)})          -- fill = thin part in the opening
--   PortalFX.SwirlParticles(portal.PortalFill, {Color = Color3.fromRGB(80,255,120)})
--   PortalFX.CodeRain(pillar.Screen, Enum.NormalId.Front, {Columns = 8})              -- falling glyphs on a face
--   PortalFX.CodeCurtain(CFrame.new(0,10,0), Vector3.new(8,16,0.2), {})               -- free-standing code beam
--   PortalFX.GlowPulse(portal.Gem, {Period = 3})                                      -- Neon part / light breathes
-- Usage (client, one LocalScript):  require(game.ReplicatedStorage.PortalFX).Animate()

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local PortalFX = {}

PortalFX.TEX = {
	Swirl = "rbxasset://textures/particles/forcefield_vortex_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
}
PortalFX.GLYPHS = { "0", "1", "0", "1", "7", "3", "9", "Z", "X", "V", "K", "=", "+", "<", ">", "*", ":", "|" }
PortalFX.CULL = 160 -- studs: nothing animates beyond this

local function opt(o, k, d)
	if o and o[k] ~= nil then
		return o[k]
	end
	return d
end

-- Spinning swirl: two layered decals-in-a-SurfaceGui per side, counter-rotating, additive look.
function PortalFX.Swirl(fill, o)
	local color = opt(o, "Color", Color3.fromRGB(80, 255, 120))
	local tex = opt(o, "Texture", PortalFX.TEX.Swirl)
	fill.Transparency = 1
	fill.CanCollide = false
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "PortalSwirl_" .. face.Name
		gui.Face = face
		gui.LightInfluence = 0
		gui.Brightness = opt(o, "Brightness", 1.6)
		gui.PixelsPerStud = 40
		gui.ZOffset = 1
		gui.Parent = fill
		for i, spec in ipairs({ { 1.15, 0.15, 1 }, { 0.85, 0.35, -1.6 } }) do
			local img = Instance.new("ImageLabel")
			img.Name = "Layer" .. i
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromScale(spec[1], spec[1])
			img.SizeConstraint = Enum.SizeConstraint.RelativeYY
			img.Image = tex
			img.ImageColor3 = color
			img.ImageTransparency = spec[2]
			img:SetAttribute("SpinSpeed", spec[3] * opt(o, "Speed", 60)) -- degrees per second
			img.Parent = gui
			CollectionService:AddTag(img, "PortalFX_Spin")
		end
	end
	return fill
end

-- Particles that spiral into the middle: an emitter on an attachment the client orbits around the rim.
function PortalFX.SwirlParticles(fill, o)
	local color = opt(o, "Color", Color3.fromRGB(80, 255, 120))
	local radius = opt(o, "Radius", math.min(fill.Size.X, fill.Size.Y) * 0.42)
	for i = 1, opt(o, "Arms", 2) do
		local a = Instance.new("Attachment")
		a.Name = "SwirlArm" .. i
		a:SetAttribute("Radius", radius)
		a:SetAttribute("Phase", (i - 1) / opt(o, "Arms", 2) * math.pi * 2)
		a:SetAttribute("Speed", opt(o, "Speed", 2.2)) -- radians per second
		a.Parent = fill
		CollectionService:AddTag(a, "PortalFX_Orbit")
		local p = Instance.new("ParticleEmitter")
		p.Texture = opt(o, "Texture", PortalFX.TEX.Spark)
		p.Color = ColorSequence.new(color)
		p.LightEmission = 1
		p.LightInfluence = 0
		p.Rate = opt(o, "Rate", 18)
		p.Lifetime = NumberRange.new(0.8, 1.4)
		p.Speed = NumberRange.new(0.5, 1.5)
		p.SpreadAngle = Vector2.new(20, 20)
		p.Drag = 2
		p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) })
		p.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		p.LockedToPart = false -- leaves a spiral trail as the attachment orbits
		p.Parent = a
	end
	return fill
end

-- Falling code on one face of a part (a screen, a pillar side, a floor strip).
function PortalFX.CodeRain(part, face, o)
	local color = opt(o, "Color", Color3.fromRGB(70, 255, 110))
	local gui = Instance.new("SurfaceGui")
	gui.Name = "CodeRain_" .. face.Name
	gui.Face = face
	gui.LightInfluence = 0
	gui.Brightness = opt(o, "Brightness", 1.4)
	gui.PixelsPerStud = 30
	gui.ClipsDescendants = true
	gui.Parent = part
	local cols = opt(o, "Columns", 8)
	local rows = opt(o, "Rows", 14)
	for c = 1, cols do
		local col = Instance.new("TextLabel")
		col.Name = "Col" .. c
		col.BackgroundTransparency = 1
		col.Size = UDim2.fromScale(1 / cols, 1.2)
		col.Position = UDim2.fromScale((c - 1) / cols, -1.2 + math.random())
		col.Font = Enum.Font.Code
		col.TextScaled = true
		col.RichText = true
		col.TextColor3 = color
		col.TextTransparency = opt(o, "Transparency", 0.1)
		col.TextYAlignment = Enum.TextYAlignment.Bottom
		col:SetAttribute("Rows", rows)
		col:SetAttribute("FallSpeed", 0.25 + math.random() * 0.35) -- screen heights per second
		col.Parent = gui
		CollectionService:AddTag(col, "PortalFX_Rain")
	end
	return gui
end

-- Free-standing see-through code beam (both sides), e.g. columns of falling code around a portal.
function PortalFX.CodeCurtain(cf, size, o)
	local p = Instance.new("Part")
	p.Name = opt(o, "Name", "CodeCurtain")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	PortalFX.CodeRain(p, Enum.NormalId.Front, o)
	PortalFX.CodeRain(p, Enum.NormalId.Back, o)
	p.Parent = opt(o, "Parent", workspace)
	return p
end

-- Slow breathing glow on a Neon part (or any part with a PointLight/SurfaceLight inside).
function PortalFX.GlowPulse(part, o)
	part:SetAttribute("PulsePeriod", opt(o, "Period", 3))
	part:SetAttribute("PulseMin", opt(o, "Min", 0.35)) -- fraction of the base brightness
	CollectionService:AddTag(part, "PortalFX_Pulse")
	return part
end

-- ---------------------------------------------------------------- client
local function randomColumn(rows)
	local t = {}
	for r = 1, rows do
		local g = PortalFX.GLYPHS[math.random(#PortalFX.GLYPHS)]
		if r == rows then
			g = '<font color="#E8FFE8">' .. g .. "</font>" -- bright head at the bottom of the stream
		end
		t[r] = g
	end
	return table.concat(t, "\n")
end

local function near(inst, cam)
	local base = inst:FindFirstAncestorWhichIsA("BasePart")
	if not base then
		return false
	end
	return (base.Position - cam.CFrame.Position).Magnitude < PortalFX.CULL
end

function PortalFX.Animate()
	assert(RunService:IsClient(), "PortalFX.Animate runs on the client")
	local base = {}
	local t0 = os.clock()
	local last = t0
	local nearCache, nextCheck = {}, 0
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local dt = now - last
		last = now
		local t = now - t0
		local cam = workspace.CurrentCamera
		local check = now > nextCheck
		if check then
			nextCheck = now + 0.5
		end
		local function isNear(inst)
			if check or nearCache[inst] == nil then
				nearCache[inst] = near(inst, cam)
			end
			return nearCache[inst]
		end
		for _, img in ipairs(CollectionService:GetTagged("PortalFX_Spin")) do
			if isNear(img) then
				img.Rotation = (img.Rotation + img:GetAttribute("SpinSpeed") * dt) % 360
			end
		end
		for _, a in ipairs(CollectionService:GetTagged("PortalFX_Orbit")) do
			if isNear(a) then
				local ang = a:GetAttribute("Phase") + t * a:GetAttribute("Speed")
				local r = a:GetAttribute("Radius") * (0.55 + 0.45 * math.abs(math.sin(t * 0.7)))
				a.Position = Vector3.new(math.cos(ang) * r, math.sin(ang) * r, 0)
			end
		end
		for _, col in ipairs(CollectionService:GetTagged("PortalFX_Rain")) do
			if isNear(col) then
				local y = col.Position.Y.Scale + col:GetAttribute("FallSpeed") * dt
				if y > 1 or col.Text == "" then
					y = -1.2
					col.Text = randomColumn(col:GetAttribute("Rows"))
					col:SetAttribute("FallSpeed", 0.25 + math.random() * 0.35)
				end
				col.Position = UDim2.fromScale(col.Position.X.Scale, y)
			end
		end
		for _, p in ipairs(CollectionService:GetTagged("PortalFX_Pulse")) do
			if isNear(p) then
				local k = p:GetAttribute("PulseMin")
				local s = k + (1 - k) * (0.5 + 0.5 * math.sin(t * math.pi * 2 / p:GetAttribute("PulsePeriod")))
				for _, l in ipairs(p:GetDescendants()) do
					if l:IsA("Light") then
						base[l] = base[l] or l.Brightness
						l.Brightness = base[l] * s
					end
				end
				base[p] = base[p] or p.Transparency
				p.Transparency = base[p] + (1 - s) * 0.35
			end
		end
	end)
end

return PortalFX
]]></ProtectedString></Properties></Item><Item class="Script" referent="T9"><Properties><string name="Name">PurchaseHandler</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- PurchaseHandler.server.lua — safe developer product + game pass handling (Script in ServerScriptService).
-- version: 1
-- changelog: v1 2026-10-23 first version
-- Grants ONLY from the receipt handler, idempotent by PurchaseId, returns NotProcessedYet if the player
-- isn't here or saving fails (Roblox retries). One handler for the whole game.
-- Fill PRODUCTS / PASSES, and connect Data.Get/Data.Update to your data module (ProfileStore recommended).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

-- >>> plug in your data layer (must persist PurchaseIds with the player's data) <<<
local Data = {
	-- returns the player's live data table or nil if not loaded
	Get = function(player) return player:GetAttribute("DataLoaded") and _G.PlayerData and _G.PlayerData[player] end,
	-- persists immediately if your module supports it; return true on success
	Save = function(player) return true end,
}

local PRODUCTS = { -- [productId] = function(player, data) ... end
	-- [123456] = function(player, data) data.Coins += 1000 end,
}
local PASSES = { -- [gamePassId] = function(player) ... end   (apply perk; ownership is checked on join)
	-- [987654] = function(player) player:SetAttribute("VIP", true) end,
}

local function grantFromReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local data = Data.Get(player)
	if not data then return Enum.ProductPurchaseDecision.NotProcessedYet end
	data.Purchases = data.Purchases or {}
	if data.Purchases[receipt.PurchaseId] then return Enum.ProductPurchaseDecision.PurchaseGranted end
	local grant = PRODUCTS[receipt.ProductId]
	if not grant then warn("[Purchase] unknown product", receipt.ProductId); return Enum.ProductPurchaseDecision.NotProcessedYet end
	local ok, err = pcall(grant, player, data)
	if not ok then warn("[Purchase] grant failed", err); return Enum.ProductPurchaseDecision.NotProcessedYet end
	data.Purchases[receipt.PurchaseId] = os.time()
	if not Data.Save(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end
MarketplaceService.ProcessReceipt = grantFromReceipt

local function checkPasses(player)
	for passId, apply in pairs(PASSES) do
		local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, passId)
		if ok and owns then task.spawn(apply, player) end
	end
end
Players.PlayerAdded:Connect(checkPasses)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(checkPasses, p) end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if purchased and PASSES[passId] then PASSES[passId](player) end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T10"><Properties><string name="Name">RemoteGuard</string><ProtectedString name="Source"><![CDATA[-- RemoteGuard.lua — validated, rate-limited RemoteEvents/Functions (ModuleScript in ReplicatedStorage; use from server).
-- version: 1
-- changelog: v1 2026-10-23 first version
-- Rules from Roblox's client-server boundary docs: never trust the client; check types, finite numbers, sizes,
-- instance location, distance; rate-limit per player.
-- local Guard = require(game.ReplicatedStorage.RemoteGuard)
-- Guard.On("BuyItem", { "string" }, { rate = 4, per = 1 }, function(player, itemId)
--     -- server decides price/ownership here
-- end)
-- Guard.OnInvoke("GetShop", {}, { rate = 2, per = 1 }, function(player) return Shop.List end)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Guard = {}
local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder and RunService:IsServer() then
	folder = Instance.new("Folder"); folder.Name = "Remotes"; folder.Parent = ReplicatedStorage
end

local MAX_STRING = 200
local buckets = {} -- [player][name] = { tokens, last }

local function finite(n) return typeof(n) == "number" and n == n and math.abs(n) ~= math.huge end
local function finiteVec(v) return finite(v.X) and finite(v.Y) and finite(v.Z) end

-- Type spec per argument: "string" | "number" | "integer" | "boolean" | "Vector3" | "Instance" | { class = "BasePart", under = workspace.Shops }
local function check(arg, spec)
	if type(spec) == "table" then
		if typeof(arg) ~= "Instance" or not arg:IsA(spec.class or "Instance") then return false end
		if spec.under and not arg:IsDescendantOf(spec.under) then return false end
		return true
	end
	if spec == "string" then return type(arg) == "string" and utf8.len(arg) ~= nil and #arg <= MAX_STRING end
	if spec == "number" then return finite(arg) end
	if spec == "integer" then return finite(arg) and arg % 1 == 0 end
	if spec == "boolean" then return type(arg) == "boolean" end
	if spec == "Vector3" then return typeof(arg) == "Vector3" and finiteVec(arg) end
	if spec == "Instance" then return typeof(arg) == "Instance" end
	return false
end

local function allowed(player, name, rate, per)
	local pb = buckets[player]; if not pb then pb = {}; buckets[player] = pb end
	local b = pb[name]; local now = os.clock()
	if not b then b = { tokens = rate, last = now }; pb[name] = b end
	b.tokens = math.min(rate, b.tokens + (now - b.last) * rate / per); b.last = now
	if b.tokens < 1 then return false end
	b.tokens -= 1; return true
end
Players.PlayerRemoving:Connect(function(p) buckets[p] = nil end)

local function validate(player, name, specs, opts, ...)
	local n = select("#", ...)
	if n ~= #specs then return false end
	for i = 1, n do if not check(select(i, ...), specs[i]) then return false end end
	if not allowed(player, name, opts.rate or 5, opts.per or 1) then return false end
	if opts.alive then
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then return false end
	end
	return true
end

local function get(name, class)
	local r = folder:FindFirstChild(name)
	if not r then r = Instance.new(class); r.Name = name; r.Parent = folder end
	return r
end

function Guard.On(name, specs, opts, handler)
	local remote = get(name, "RemoteEvent")
	remote.OnServerEvent:Connect(function(player, ...)
		if validate(player, name, specs, opts or {}, ...) then
			local ok, err = pcall(handler, player, ...)
			if not ok then warn("[RemoteGuard] " .. name .. ": " .. tostring(err)) end
		end
	end)
	return remote
end

function Guard.OnInvoke(name, specs, opts, handler)
	local remote = get(name, "RemoteFunction")
	remote.OnServerInvoke = function(player, ...)
		if not validate(player, name, specs, opts or {}, ...) then return nil, "rejected" end
		local ok, a, b = pcall(handler, player, ...)
		if not ok then warn("[RemoteGuard] " .. name .. ": " .. tostring(a)); return nil, "error" end
		return a, b
	end
	return remote
end

-- Server-side distance check helper (latency slack included)
function Guard.Near(player, position, maxStuds)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return hrp ~= nil and (hrp.Position - position).Magnitude <= (maxStuds or 12) + 4
end

-- Client side: Guard.Fire("BuyItem", "sword_1")
function Guard.Fire(name, ...) folder:WaitForChild(name):FireServer(...) end
function Guard.Invoke(name, ...) return folder:WaitForChild(name):InvokeServer(...) end

return Guard
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T11"><Properties><string name="Name">VFX</string><ProtectedString name="Source"><![CDATA[-- vfx.lua — ready-to-use Roblox effects (ModuleScript in ReplicatedStorage). No assets needed:
-- version: 1
-- changelog: v1 2026-10-23 first version
-- uses Roblox's built-in particle textures. Swap Texture ids for flipbooks for richer fire.
-- Usage:  local VFX = require(game.ReplicatedStorage.VFX)
--         VFX.Fireball(hrp.Position + hrp.CFrame.LookVector*3, hrp.CFrame.LookVector)
--         VFX.IgniteLegs(workspace.RobotChicken)
--         VFX.Aura(character.HumanoidRootPart, Color3.fromRGB(255, 40, 60))

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local VFX = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function seq(...) local k = {} ; local a = {...}
	for i = 1, #a, 2 do table.insert(k, NumberSequenceKeypoint.new(a[i], a[i+1])) end
	return NumberSequence.new(k) end
local function cseq(c0: Color3, c1: Color3) return ColorSequence.new(c0, c1) end

local function emitter(parent: Instance, props: {[string]: any}): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	e.LightEmission = 1           -- additive glow for fire/magic
	for k, v in pairs(props) do (e :: any)[k] = v end
	e.Parent = parent
	return e
end

-- Flame layers shared by fireball + legs
local function flameLayers(att: Attachment, scale: number)
	emitter(att, { Name = "Core", Texture = FIRE, Rate = 40, Lifetime = NumberRange.new(0.15, 0.3),
		Speed = NumberRange.new(0.5, 1), Size = seq(0, 1.6*scale, 1, 0.2*scale), Transparency = seq(0, 0.1, 1, 1),
		Color = cseq(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 140, 40)), ZOffset = 1 })
	emitter(att, { Name = "Flame", Texture = FIRE, Rate = 35, Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(2, 4), SpreadAngle = Vector2.new(15, 15), Acceleration = Vector3.new(0, 6, 0),
		Size = seq(0, 1.2*scale, 1, 0), Transparency = seq(0, 0.2, 1, 1), RotSpeed = NumberRange.new(-90, 90),
		Rotation = NumberRange.new(0, 360), Color = cseq(Color3.fromRGB(255, 120, 30), Color3.fromRGB(200, 20, 20)) })
	emitter(att, { Name = "Embers", Texture = SPARK, Rate = 12, Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(3, 6), SpreadAngle = Vector2.new(40, 40), Acceleration = Vector3.new(0, 4, 0),
		Size = seq(0, 0.25*scale, 1, 0), Color = cseq(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 0)) })
	local smoke = emitter(att, { Name = "Smoke", Texture = SMOKE, Rate = 6, Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(1, 2), Acceleration = Vector3.new(0, 3, 0), Size = seq(0, 0.6*scale, 1, 2*scale),
		Transparency = seq(0, 0.7, 1, 1), Color = cseq(Color3.fromRGB(60, 40, 40), Color3.fromRGB(20, 20, 20)) })
	smoke.LightEmission = 0
	local light = Instance.new("PointLight"); light.Color = Color3.fromRGB(255, 120, 40)
	light.Brightness = 2; light.Range = 8 * scale; light.Shadows = false; light.Parent = att
end

-- Small camera shake for the local player (call on the client)
function VFX.Shake(intensity: number?, duration: number?)
	local cam = workspace.CurrentCamera; if not cam then return end
	local i, d = intensity or 0.4, duration or 0.25
	local t0 = os.clock()
	local conn; conn = game:GetService("RunService").RenderStepped:Connect(function()
		local p = (os.clock() - t0) / d
		if p >= 1 then conn:Disconnect() return end
		local a = i * (1 - p)
		cam.CFrame = cam.CFrame * CFrame.Angles(math.rad((math.random()-0.5)*a*4), math.rad((math.random()-0.5)*a*4), 0)
	end)
end

function VFX.Explosion(pos: Vector3, scale: number?)
	local s = scale or 1
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.Transparency = 1
	p.Size = Vector3.one; p.Position = pos; p.Parent = workspace
	local att = Instance.new("Attachment", p)
	local burst = emitter(att, { Texture = FIRE, Rate = 0, Lifetime = NumberRange.new(0.25, 0.5), Speed = NumberRange.new(10*s, 22*s),
		SpreadAngle = Vector2.new(180, 180), Size = seq(0, 2*s, 1, 0), Transparency = seq(0, 0, 1, 1),
		Color = cseq(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 40, 20)), Drag = 6 })
	local sparks = emitter(att, { Texture = SPARK, Rate = 0, Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(20*s, 40*s),
		SpreadAngle = Vector2.new(180, 180), Size = seq(0, 0.3*s, 1, 0), Drag = 4, Acceleration = Vector3.new(0, -30, 0) })
	burst:Emit(40); sparks:Emit(30)
	local light = Instance.new("PointLight"); light.Color = Color3.fromRGB(255, 140, 60); light.Range = 18*s; light.Brightness = 6; light.Parent = att
	TweenService:Create(light, TweenInfo.new(0.4), { Brightness = 0 }):Play()
	Debris:AddItem(p, 1.5)
end

-- Fireball: projectile with core, flames, embers, smoke, trail and light. Explodes on hit or after range.
function VFX.Fireball(origin: Vector3, direction: Vector3, speed: number?, range: number?, onHit: ((RaycastResult) -> ())?)
	local spd, rng = speed or 80, range or 200
	local ball = Instance.new("Part"); ball.Shape = Enum.PartType.Ball; ball.Size = Vector3.one * 1.6
	ball.Material = Enum.Material.Neon; ball.Color = Color3.fromRGB(255, 120, 30); ball.Anchored = true
	ball.CanCollide = false; ball.CanQuery = false; ball.CastShadow = false; ball.Parent = workspace
	local att = Instance.new("Attachment", ball); flameLayers(att, 1.4)
	local a0 = Instance.new("Attachment", ball); a0.Position = Vector3.new(0, 0.6, 0)
	local a1 = Instance.new("Attachment", ball); a1.Position = Vector3.new(0, -0.6, 0)
	local trail = Instance.new("Trail"); trail.Attachment0 = a0; trail.Attachment1 = a1; trail.Lifetime = 0.25
	trail.LightEmission = 1; trail.FaceCamera = true; trail.Color = cseq(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 30, 20))
	trail.Transparency = seq(0, 0.2, 1, 1); trail.WidthScale = seq(0, 1, 1, 0); trail.Parent = ball
	local dir = direction.Unit; local pos = origin; local travelled = 0
	local params = RaycastParams.new(); params.FilterDescendantsInstances = { ball }
	local hb; hb = game:GetService("RunService").Heartbeat:Connect(function(dt)
		local step = dir * spd * dt
		local hit = workspace:Raycast(pos, step, params)
		if hit or travelled > rng then
			hb:Disconnect()
			local at = hit and hit.Position or pos
			VFX.Explosion(at, 1.2)
			if hit and onHit then onHit(hit) end
			ball.Transparency = 1; for _, e in ipairs(att:GetChildren()) do if e:IsA("ParticleEmitter") then e.Enabled = false end end
			Debris:AddItem(ball, 1)
			return
		end
		pos += step; travelled += step.Magnitude
		ball.CFrame = CFrame.lookAt(pos, pos + dir)
	end)
	return ball
end

-- Put flames on every leg/foot of a model (bones or parts named Leg/Foot/Shin/Thigh/Ankle)
function VFX.IgniteLegs(model: Instance, scale: number?)
	local s = scale or 0.6
	local found = 0
	for _, d in ipairs(model:GetDescendants()) do
		local n = d.Name:lower()
		local isLeg = n:find("leg") or n:find("foot") or n:find("shin") or n:find("thigh") or n:find("ankle")
		if isLeg and (d:IsA("Bone") or d:IsA("BasePart")) then
			local att = d:IsA("Bone") and d or Instance.new("Attachment", d)
			flameLayers(att :: any, s); found += 1
		end
	end
	return found
end

-- Rising aura around a part (power-up, rebirth, rare pet)
function VFX.Aura(part: BasePart, color: Color3?, scale: number?)
	local c, s = color or Color3.fromRGB(255, 40, 60), scale or 1
	local att = Instance.new("Attachment", part); att.Position = Vector3.new(0, -2.5*s, 0)
	emitter(att, { Texture = SPARK, Rate = 30, Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(2, 4),
		Shape = Enum.ParticleEmitterShape.Cylinder, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		EmissionDirection = Enum.NormalId.Top, Size = seq(0, 0.35*s, 1, 0), Color = cseq(c, Color3.new(1, 1, 1)) })
	local light = Instance.new("PointLight"); light.Color = c; light.Range = 10*s; light.Brightness = 1.5; light.Parent = att
	return att
end

return VFX
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="T12"><Properties><string name="Name">Waves</string><ProtectedString name="Source"><![CDATA[-- Waves: shared Gerstner wave math so the ocean mesh, ships and anything floating agree.
-- version: 1
-- changelog: v1 2026-10-23 first version
-- Time comes from workspace:GetServerTimeNow() so every client sees the same waves.
-- Part of the ocean kit: Waves (ModuleScript) + OceanMesh (ModuleScript) + OceanClient (LocalScript),
-- all from the island build 2026-10-23. Put Waves and OceanMesh in ReplicatedStorage.
-- Per map, set: Center (island XZ), CalmRadius/FullRadius (calm lagoon -> open sea),
-- and IslandShape (the coastline, used for shore foam; match your terrain).
-- Needs EditableMesh enabled: Game Settings > Security > allow Mesh/Image APIs. Without it,
-- OceanClient falls back to terrain water and sets Lift = 0.
local Waves = {}

Waves.SeaLevel = 0.3
-- Lift raises the waves so troughs stay above the terrain water (y = 0) that sits under the
-- mesh ocean for swimming. Set to 0 when the mesh ocean isn't running.
Waves.Lift = 1
Waves.Center = Vector2.new(0, 0)   -- island center (XZ); water is calmer near it
Waves.CalmRadius = 45              -- inside this the sea is a calm lagoon
Waves.FullRadius = 140             -- full-size waves from here out
Waves.FadeStart = 420              -- waves fade to flat toward the horizon
Waves.FadeEnd = 900

-- dir (XZ), wavelength (studs), amplitude (studs)
local LIST = {
	{ Vector2.new(1, 0.25), 110, 1.3 },
	{ Vector2.new(0.75, 0.65), 62, 0.8 },
	{ Vector2.new(0.2, 1), 34, 0.42 },
	{ Vector2.new(-0.55, 0.85), 19, 0.2 },
}
local W = {}
for _, w in ipairs(LIST) do
	local d = w[1].Unit
	local k = 2 * math.pi / w[2]
	local c = math.sqrt(w[2]) * 1.15            -- phase speed, studs/s
	local q = math.min(1, 0.8 / (k * w[3] * #LIST)) -- steepness, no loops
	table.insert(W, { dx = d.X, dz = d.Y, k = k, kc = k * c, a = w[3], qa = q * w[3] })
end
Waves.MaxAmplitude = 0
for _, w in ipairs(W) do Waves.MaxAmplitude += w.a end

local function smooth(e0, e1, x)
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- 0..1 wave strength at a point (calm lagoon near the island, flat horizon far away)
function Waves.Strength(x: number, z: number): number
	local r = math.sqrt((x - Waves.Center.X) ^ 2 + (z - Waves.Center.Y) ^ 2)
	local near = 0.18 + 0.82 * smooth(Waves.CalmRadius, Waves.FullRadius, r)
	local far = 1 - smooth(Waves.FadeStart, Waves.FadeEnd, r)
	return near * far
end

-- Full Gerstner displacement: returns dx, dy, dz
function Waves.Displace(x: number, z: number, t: number, s: number?)
	s = s or Waves.Strength(x, z)
	if s <= 0 then return 0, 0, 0 end
	local ox, oy, oz = 0, 0, 0
	for _, w in ipairs(W) do
		local f = w.k * (w.dx * x + w.dz * z) - w.kc * t
		local cf, sf = math.cos(f), math.sin(f)
		ox += w.qa * w.dx * cf
		oz += w.qa * w.dz * cf
		oy += w.a * sf
	end
	return ox * s, (oy + Waves.MaxAmplitude * Waves.Lift) * s, oz * s
end

-- Displacement + surface normal (Gerstner): returns dx, dy, dz, nx, ny, nz
function Waves.DisplaceNormal(x: number, z: number, t: number, s: number?)
	s = s or Waves.Strength(x, z)
	if s <= 0 then return 0, 0, 0, 0, 1, 0 end
	local ox, oy, oz, nx, ny, nz = 0, 0, 0, 0, 0, 0
	for _, w in ipairs(W) do
		local f = w.k * (w.dx * x + w.dz * z) - w.kc * t
		local cf, sf = math.cos(f), math.sin(f)
		ox += w.qa * w.dx * cf
		oz += w.qa * w.dz * cf
		oy += w.a * sf
		local wa = w.k * w.a
		nx += w.dx * wa * cf
		nz += w.dz * wa * cf
		ny += w.k * w.qa * sf
	end
	return ox * s, (oy + Waves.MaxAmplitude * Waves.Lift) * s, oz * s, -nx * s, 1 - ny * s, -nz * s
end

-- Surface height (ignores the small horizontal shift; good enough for floating objects)
function Waves.Height(x: number, z: number, t: number): number
	local _, dy = Waves.Displace(x, z, t)
	return Waves.SeaLevel + dy
end

-- Island coastline (matches the terrain height map): ~1 at the waterline, <1 inland
function Waves.IslandShape(x: number, z: number): number
	local dx, dz = x - Waves.Center.X, z - Waves.Center.Y
	local th = math.atan2(dz, dx)
	local R = 54 + 9 * math.sin(2 * th + 1) + 6 * math.sin(3 * th + 2.2) + 3 * math.sin(5 * th + 0.4)
	return math.sqrt(dx * dx + dz * dz) / R
end

function Waves.Now(): number
	return workspace:GetServerTimeNow()
end

return Waves
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>